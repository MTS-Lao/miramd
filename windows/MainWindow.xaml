<Window
    x:Class="MiraMD.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="New" Click="New_Click" />
            <AppBarButton Icon="OpenFile" Label="Open" Click="Open_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
            <AppBarSeparator />
            <AppBarButton Label="Copy for AI" Click="CopyForAi_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Export" Click="ExportForAi_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="Document" Label="Clean MD" Click="ExportCleanMarkdown_Click" ToolTipService.ToolTip="Export standard Markdown without highlight markers" />
            <AppBarButton Icon="Document" Label="Word" Click="ExportWord_Click" ToolTipService.ToolTip="Export to Microsoft Word with Lao and Unicode support" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="ThemePicker" Width="112" PlaceholderText="Theme" SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                    <ToggleButton x:Name="VisualModeButton" Content="Visual" IsChecked="True" Click="VisualMode_Click" />
                    <ToggleButton x:Name="EditModeButton" Content="Edit" Click="EditMode_Click" />
                    <ToggleButton x:Name="SplitModeButton" Content="Split" Click="SplitMode_Click" />
                    <ToggleButton x:Name="PreviewModeButton" Content="Preview" Click="PreviewMode_Click" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <ScrollViewer x:Name="FormattingBar" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="12,7">
                <Button Content="H1" Tag="1" Click="Heading_Click" ToolTipService.ToolTip="Heading 1" />
                <Button Content="H2" Tag="2" Click="Heading_Click" ToolTipService.ToolTip="Heading 2" />
                <Button Content="H3" Tag="3" Click="Heading_Click" ToolTipService.ToolTip="Heading 3" />
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="5,0" />
                <Button Content="B" FontWeight="Bold" Tag="bold" Click="Wrap_Click" ToolTipService.ToolTip="Bold" />
                <Button Content="I" FontStyle="Italic" Tag="italic" Click="Wrap_Click" ToolTipService.ToolTip="Italic" />
                <Button Content="Highlight" Tag="highlight" Click="Wrap_Click" ToolTipService.ToolTip="Highlight for human reference" />
                <Button Content="Link" Tag="link" Click="Wrap_Click" />
                <Button Content="Code" Tag="code" Click="Wrap_Click" />
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="5,0" />
                <Button Content="• List" Tag="bullet" Click="Prefix_Click" />
                <Button Content="1. List" Tag="number" Click="Prefix_Click" />
                <Button Content="☐ Task" Tag="task" Click="Prefix_Click" />
                <Button Content="❝ Quote" Tag="quote" Click="Prefix_Click" />
                <Button Content="Code block" Tag="codeblock" Click="Wrap_Click" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIBRARY" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.72" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                            <Button Content="Choose" Click="ChooseWorkspace_Click" ToolTipService.ToolTip="Choose a Markdown folder" />
                            <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="RefreshWorkspace_Click" ToolTipService.ToolTip="Refresh library" />
                            <Button Content="+" Click="NewWorkspaceFile_Click" ToolTipService.ToolTip="New Markdown file" />
                            <Button Content="+ Folder" Click="NewWorkspaceFolder_Click" ToolTipService.ToolTip="New folder" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WorkspacePathText" Grid.Row="1" Margin="0,8,0,7" Text="Choose a folder…" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                    <TextBox x:Name="WorkspaceFilter" Grid.Row="2" Margin="0,0,0,6" PlaceholderText="Filter Markdown" TextChanged="WorkspaceFilter_TextChanged" />
                    <TreeView x:Name="WorkspaceTree" Grid.Row="3" Margin="-8,0,-8,12" ItemInvoked="WorkspaceTree_ItemInvoked" />
                    <TextBlock Grid.Row="4" Text="DOCUMENT" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.72" />
                    <TextBlock x:Name="DocumentStatsText" Grid.Row="5" Margin="0,8,0,16" TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Grid.Row="6" Text="OUTLINE" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.72" />
                    <ListView x:Name="OutlineList" Grid.Row="7" Margin="-8,6,-8,0" SelectionChanged="OutlineList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Line}" Margin="8,0,0,0" Opacity="0.55" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Editor"
                    Grid.Column="0"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="14"
                    Padding="22"
                    BorderThickness="0,0,1,0"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    TextChanged="Editor_TextChanged" />
                <WebView2 x:Name="Preview" Grid.Column="1" NavigationStarting="Preview_NavigationStarting" WebMessageReceived="Preview_WebMessageReceived" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock x:Name="StatusText" Opacity="0.7" />
                <TextBlock Text="Markdown" HorizontalAlignment="Right" Opacity="0.7" />
            </Grid>
        </Border>
    </Grid>
</Window>
